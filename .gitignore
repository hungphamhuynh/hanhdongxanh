# ==========================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
migrate_working_dir/
.widget_preview/
**/doc/api/
**/ios/Flutter/.last_build_id

# Obfuscation & Symbolication
app.*.symbols
app.*.map.json

# Build Outputs
*.apk
*.aab
*.ipa
*.dSYM.zip
/android/app/debug
/android/app/profile
/android/app/release

# Fastlane (CI/CD)
