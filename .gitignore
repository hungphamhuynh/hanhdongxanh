.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# 2. Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
*.local

# Firebase / Google Services Credentials
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/ios/Firebase/*.plist

# Keystores & Certificates
*.jks
*.keystore
*.p12
*.cer
*.mobileprovision
key.properties

# ==========================================
# 3. IDEs & Editors
# ==========================================
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
.idea_modules/

# VS Code (Giữ lại cấu hình debug chung, bỏ file cá nhân)
